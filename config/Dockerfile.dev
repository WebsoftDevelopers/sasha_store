# syntax=docker/dockerfile:1

# API=====================================================================================================================================
FROM node:22-alpine AS api-base
WORKDIR /app

FROM api-base AS api-deps
COPY apis/package.json apis/package-lock.json ./
COPY apis/prisma ./prisma
COPY apis/prisma.config.ts ./
RUN npm ci

FROM api-deps AS api
RUN apk add --no-cache bash
COPY apis ./
COPY config/scripts/api-entrypoint.dev.sh /usr/local/bin/api-entrypoint.dev.sh
RUN chmod +x /usr/local/bin/api-entrypoint.dev.sh
EXPOSE 8000
ENTRYPOINT ["api-entrypoint.dev.sh"]

# Web=====================================================================================================================================
FROM node:22-bookworm-slim AS web-base
WORKDIR /app

FROM web-base AS web-deps
COPY web/package.json web/package-lock.json ./
RUN npm ci --include=optional

FROM web-deps AS web
COPY web ./
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0"]

# Mobile=====================================================================================================================================
FROM node:22-alpine AS mobile-base
WORKDIR /app

FROM mobile-base AS mobile-deps
COPY mobile/package.json ./
RUN npm install

FROM mobile-deps AS mobile
COPY mobile/tsconfig.json ./
COPY mobile/src ./src
EXPOSE 3001
CMD ["npm", "run", "dev"]

# Agent=====================================================================================================================================
FROM python:3.12-slim AS agent-base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
COPY agent/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY agent/main.py .
EXPOSE 8001

FROM agent-base AS agent
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8001", "--reload"]
