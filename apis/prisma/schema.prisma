generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum AuthProvider {
  email
  google
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String       @id @db.Uuid
  email        String       @unique
  fullName     String?      @map("full_name")
  avatarUrl    String?      @map("avatar_url")
  authProvider AuthProvider @default(email) @map("auth_provider")
  role         UserRole     @default(CUSTOMER)
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  shop           Shop?
  ratings        Rating[]
  ordersBought   Order[]      @relation("BuyerOrders")

  @@map("users")
}

model Shop {
  id                 String             @id @default(uuid()) @db.Uuid
  ownerId            String             @unique @map("owner_id") @db.Uuid
  name               String
  slug               String             @unique
  description        String?
  logoUrl            String?            @map("logo_url")
  legalName          String             @map("legal_name")
  cacNumber          String             @map("cac_number")
  tin                String?
  businessAddress    String             @map("business_address")
  city               String
  state              String
  phone              String
  email              String
  cacDocumentUrl     String?            @map("cac_document_url")
  idDocumentUrl      String?            @map("id_document_url")
  proofOfAddressUrl  String?            @map("proof_of_address_url")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  isVerified         Boolean            @default(false) @map("is_verified")
  verificationNote   String?            @map("verification_note")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  @@index([verificationStatus])
  @@map("shops")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  imageUrl    String?  @map("image_url")
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ratings    Rating[]
  orderItems OrderItem[]

  @@index([shopId])
  @@index([category])
  @@map("products")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@map("ratings")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  shopId          String      @map("shop_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String      @map("shipping_address")
  shippingCity    String      @map("shipping_city")
  shippingState   String      @map("shipping_state")
  shippingPhone   String      @map("shipping_phone")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  buyer User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([buyerId])
  @@index([shopId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  name      String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}
