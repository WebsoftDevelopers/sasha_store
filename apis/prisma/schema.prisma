generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

enum AuthProvider {
  email
  google
}

enum VendorStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  DISABLED
}

enum MediaAssetType {
  IMAGE
  VIDEO
  DOCUMENT
  BLOB
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String       @id @db.Uuid
  email        String       @unique
  fullName     String?      @map("full_name")
  avatarUrl    String?      @map("avatar_url")
  authProvider AuthProvider @default(email) @map("auth_provider")
  role         UserRole     @default(CUSTOMER)
  status       UserStatus   @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  shop           Shop?
  mediaAssets    MediaAsset[]
  ratings        Rating[]
  ordersBought   Order[]      @relation("BuyerOrders")

  @@map("users")
}

model Shop {
  id                              String       @id @default(uuid()) @db.Uuid
  ownerId                         String       @unique @map("owner_id") @db.Uuid
  name                            String
  slug                            String       @unique
  description                     String?
  logoUrl                         String?      @map("logo_url")
  bannerUrl                       String?      @map("banner_url")
  category                        String?
  ownerFirstName                  String?      @map("owner_first_name")
  ownerLastName                   String?      @map("owner_last_name")
  ownerEmail                      String?      @map("owner_email")
  ownerPhone                      String?      @map("owner_phone")
  alternativePhone                String?      @map("alternative_phone")
  identificationType              String?      @map("identification_type")
  identificationNumber            String?      @map("identification_number")
  legalName                       String       @map("legal_name")
  registeredBusinessName          String?      @map("registered_business_name")
  cacNumber                       String       @map("cac_number")
  businessRegistrationType        String?      @map("business_registration_type")
  tin                             String?
  registrationDate                DateTime?    @map("registration_date") @db.Date
  businessAddress                 String       @map("business_address")
  country                         String?      @default("Nigeria")
  city                            String
  state                           String
  lga                             String?
  streetAddress                   String?      @map("street_address")
  postalCode                      String?      @map("postal_code")
  latitude                        Decimal?     @db.Decimal(10, 7)
  longitude                       Decimal?     @db.Decimal(10, 7)
  phone                           String
  email                           String
  businessPhone                   String?      @map("business_phone")
  businessEmail                   String?      @map("business_email")
  website                         String?
  socialLinks                     Json?        @map("social_links")
  cacDocumentUrl                  String?      @map("cac_document_url")
  idDocumentUrl                   String?      @map("id_document_url")
  proofOfAddressUrl               String?      @map("proof_of_address_url")
  businessRegistrationDocumentUrl String?      @map("business_registration_document_url")
  taxCertificateUrl               String?      @map("tax_certificate_url")
  additionalDocumentUrls          Json?        @map("additional_document_urls")
  vendorStatus                    VendorStatus @default(NONE) @map("vendor_status")
  isVerified                      Boolean      @default(false) @map("is_verified")
  adminComment                    String?      @map("admin_comment")
  rejectionReason                 String?      @map("rejection_reason")
  missingDocuments                Json?        @map("missing_documents")
  reviewedAt                      DateTime?    @map("reviewed_at")
  reviewedById                    String?      @map("reviewed_by_id") @db.Uuid
  createdAt                       DateTime     @default(now()) @map("created_at")
  updatedAt                       DateTime     @updatedAt @map("updated_at")

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  @@index([vendorStatus])
  @@index([vendorStatus, updatedAt])
  @@map("shops")
}

model MediaAsset {
  id           String         @id @default(uuid()) @db.Uuid
  ownerId      String         @map("owner_id") @db.Uuid
  assetType    MediaAssetType @map("asset_type")
  context      String?
  entityType   String?        @map("entity_type")
  entityId     String?        @map("entity_id") @db.Uuid
  url          String
  secureUrl    String?        @map("secure_url")
  publicId     String         @unique @map("public_id")
  resourceType String         @map("resource_type")
  format       String?
  mimeType     String?        @map("mime_type")
  bytes        Int?
  width        Int?
  height       Int?
  duration     Decimal?       @db.Decimal(10, 3)
  provider     String         @default("minio")
  folder       String?
  metadata     Json?
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([assetType])
  @@index([context])
  @@index([entityType, entityId])
  @@map("media_assets")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @map("shop_id") @db.Uuid
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  category    String?
  imageUrl    String?  @map("image_url")
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  shop       Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  ratings    Rating[]
  orderItems OrderItem[]

  @@index([shopId])
  @@index([shopId, createdAt])
  @@index([category])
  @@index([isActive, createdAt])
  @@index([isActive, category, createdAt])
  @@index([isActive, price])
  @@map("products")
}

model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  score     Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([productId, createdAt])
  @@map("ratings")
}

model Order {
  id              String      @id @default(uuid()) @db.Uuid
  buyerId         String      @map("buyer_id") @db.Uuid
  shopId          String      @map("shop_id") @db.Uuid
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String      @map("shipping_address")
  shippingCity    String      @map("shipping_city")
  shippingState   String      @map("shipping_state")
  shippingPhone   String      @map("shipping_phone")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  buyer User        @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  shop  Shop        @relation(fields: [shopId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([buyerId])
  @@index([buyerId, createdAt])
  @@index([shopId])
  @@index([shopId, createdAt])
  @@index([shopId, status, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  name      String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}
