# Copy to .env.docker and fill in Supabase + Cloudinary values.
# cp .env.docker.example .env.docker

# --- Postgres (local Docker) ---
POSTGRES_USER=sasha
POSTGRES_PASSWORD=sasha
POSTGRES_DB=sasha_store
POSTGRES_PORT=5432

# --- App ports (host) ---
API_PORT=8000
WEB_PORT=3000
MOBILE_PORT=3001
AGENTIC_AI_PORT=8001

# --- Support tools (profile: tools) ---
ADMINER_PORT=8080
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
REDIS_PORT=6379

# --- API (NestJS) ---
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
RUN_SEED=false

# Supabase Auth — required. Use your cloud project or local Supabase CLI (`npx supabase start`).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
# Or for newer projects:
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Cloudinary (unsigned preset on the client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
NEXT_PUBLIC_CLOUDINARY_FOLDER=sasha-store/products
