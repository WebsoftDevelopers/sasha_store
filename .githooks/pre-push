#!/usr/bin/env sh
set -eu

protected_branches="production main staging development"

is_protected_branch() {
  branch="$1"
  for protected in $protected_branches; do
    if [ "$branch" = "$protected" ]; then
      return 0
    fi
  done
  return 1
}

blocked=""

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*)
      remote_branch=${remote_ref#refs/heads/}
      if is_protected_branch "$remote_branch"; then
        blocked="${blocked}
${remote_branch}"
      fi
      ;;
  esac
done

if [ -n "$blocked" ]; then
  echo "Push blocked: direct pushes to protected branches are not allowed."
  echo
  echo "Protected branches:"
  echo "$protected_branches" | tr ' ' '\n' | sed 's/^/  - /'
  echo
  echo "Push your work to a feature branch and open a PR instead."
  exit 1
fi
